{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "http://10.0.2.2:4000/api" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://subscription-tracker-42pr.onrender.com/api",
        "EXPO_PUBLIC_ENABLE_DEMO": "true"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
