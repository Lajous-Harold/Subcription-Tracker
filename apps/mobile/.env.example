# URL de l'API (préfixe /api inclus).
# Web et émulateur iOS : http://localhost:4000/api
# Émulateur Android : http://10.0.2.2:4000/api
# Téléphone physique : http://<IP-de-votre-PC>:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Affiche la carte « Données de démonstration » dans un build de production (soutenance, démo).
# L'API doit avoir ENABLE_DEMO_DATA=true (valeur par défaut hors production).
EXPO_PUBLIC_ENABLE_DEMO=false
