# Copier en apps/api/.env puis compléter. Ne jamais versionner .env.

APP_ENV=development
PORT=4000
# URL publique de l'API (vérification des webhooks Powens)
PUBLIC_API_URL=http://localhost:4000

# Docker Compose remplace cette valeur par mongodb://mongo:27017/subtracker
MONGODB_URI=mongodb://localhost:27017/subtracker

# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Origines web autorisées (Expo web en dev : 8081)
CORS_ORIGINS=http://localhost:8081

# Rétention des données bancaires (années)
DATA_RETENTION_YEARS=5

# Données de démonstration (POST/DELETE /api/demo/data) : actives par défaut hors production
# ENABLE_DEMO_DATA=true

# --- Powens (sandbox) : laisser vide tant que le compte n'est pas créé ---
# Domaine : sous-domaine (ex. monprojet-sandbox) ou complet (monprojet-sandbox.biapi.pro)
POWENS_DOMAIN=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
# Clé HMAC des webhooks (affichée une seule fois à la création)
POWENS_WEBHOOK_SECRET=
POWENS_WEBVIEW_LANG=fr
# Doivent figurer dans la liste blanche de la console Powens
POWENS_REDIRECT_URI_NATIVE=subtracker://powens/callback
# Par défaut : <PUBLIC_API_URL>/powens/callback si l'API sert l'app web (WEB_DIST_DIR), sinon http://localhost:8081/powens/callback
# POWENS_REDIRECT_URI_WEB=
