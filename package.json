{
  "name": "subscription-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "Gestion et détection automatique d'abonnements bancaires (Expo + Express + MongoDB + Powens)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "npm run dev -w @subtracker/api",
    "dev:mobile": "npm run start -w @subtracker/mobile",
    "build:api": "npm run build -w @subtracker/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "openapi": "npm run openapi -w @subtracker/api",
    "expo-go": "npm run expo-go -w @subtracker/mobile",
    "demo:check": "node scripts/demo-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "jest": "^30.5.2",
    "prettier": "^3.6.0",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
